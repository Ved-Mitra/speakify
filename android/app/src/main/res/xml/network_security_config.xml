<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic to localhost only. just_audio's StreamAudioSource uses an internal HTTP server on 127.0.0.1 to feed audio data to ExoPlayer. Android 9+ blocks cleartext HTTP by default, so we explicitly permit it here for localhost only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
